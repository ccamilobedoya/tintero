// Template for the private data of the firmware.
// Copy it to include/secrets.h and fill it in. secrets.h is never shared or
// committed (git ignores it).
//
// The server name and the certificates do NOT go here: they come from
// include/tintero_certs.h, which `npm run pki -- firmware` generates.
#pragma once

// 2.4 GHz Wi-Fi network (the ESP32 cannot join 5 GHz networks).
constexpr char WIFI_SSID[] = "your-network-name";
constexpr char WIFI_PASS[] = "your-network-password";

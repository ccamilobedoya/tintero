    "/api/v1/actions": {
      "post": {
        "operationId": "postActions",
        "summary": "Send actions done by the device (idempotent by id)",
        "parameters": [
          {
            "name": "Tintero-Protocol",
            "in": "header",
            "required": true,
            "description": "Protocol version.",
            "schema": { "type": "string", "enum": ["1"] },

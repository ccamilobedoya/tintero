              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "busy", "msg": "busy" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceCertificate": { "type": "mutualTLS", "description": "Per-device certificate (L1)." }
    },
    "schemas": {
      "IndexResponse": {
        "type": "object",
        "required": [
          "protocol",
          "server_time",
          "next_wake_s",
          "full_refresh",
          "panel",
          "current",
          "views"
        ],
        "properties": {
          "protocol": { "type": "number", "const": 1 },
          "server_time": { "type": "integer", "minimum": 0 },
          "next_wake_s": { "type": "integer", "minimum": 30, "maximum": 86400 },
          "full_refresh": { "type": "boolean" },
          "panel": {
            "type": "object",
            "required": ["w", "h", "dpi", "depth"],
            "properties": {
              "w": { "type": "integer", "minimum": 8, "maximum": 2048 },
              "h": { "type": "integer", "minimum": 8, "maximum": 2048 },
              "dpi": { "type": "integer", "minimum": 50, "maximum": 400 },
              "depth": { "type": "number", "const": 1 }
            }
          },
          "current": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "hash", "format", "bytes", "crc32"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
                "hash": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" },
                "format": {
                  "anyOf": [
                    { "type": "string", "const": "raw1" },
                    { "type": "string", "const": "png1" }
                  ]
                },
                "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
                "crc32": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
              }
            },
            "minItems": 1,
            "maxItems": 16
          }
        }
      },
      "ZonesResponse": {
        "type": "object",
        "required": ["view", "hash", "zones"],
        "properties": {
          "view": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "x", "y", "w", "h", "act"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
                "x": { "type": "integer", "minimum": 0, "maximum": 2048 },
                "y": { "type": "integer", "minimum": 0, "maximum": 2048 },
                "w": { "type": "integer", "minimum": 8, "maximum": 2048 },
                "h": { "type": "integer", "minimum": 8, "maximum": 2048 },
                "act": {
                  "anyOf": [
                    { "type": "string", "const": "toggle" },
                    { "type": "string", "const": "open" }
                  ]
                }
              }
            },
            "minItems": 0,
            "maxItems": 48
          }
        }
      },
      "ActionsRequest": {
        "type": "object",
        "required": ["actions"],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "view", "zone", "act", "at"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{8,24}$" },
                "view": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
                "zone": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
                "act": {
                  "anyOf": [
                    { "type": "string", "const": "toggle" },
                    { "type": "string", "const": "open" }
                  ]
                },
                "at": { "type": "integer", "minimum": 0 }
              }
            },
            "minItems": 1,
            "maxItems": 8
          }
        }
      },
      "ActionsResponse": {
        "type": "object",
        "required": ["results", "index_changed"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{8,24}$" },
                "status": {
                  "anyOf": [
                    { "type": "string", "const": "applied" },
                    { "type": "string", "const": "duplicate" },
                    { "type": "string", "const": "stale" }
                  ]
                }
              }
            },
            "minItems": 1,
            "maxItems": 8
          },
          "index_changed": { "type": "boolean" }
        }
      },
      "LogRequest": {
        "type": "object",
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "level", "msg"],
              "properties": {
                "at": { "type": "integer", "minimum": 0 },
                "level": {
                  "anyOf": [
                    { "type": "string", "const": "error" },
                    { "type": "string", "const": "warn" },
                    { "type": "string", "const": "info" }
                  ]
                },
                "msg": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            },
            "minItems": 1,
            "maxItems": 10
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "msg"],
            "properties": {
              "code": {
                "anyOf": [
                  { "type": "string", "const": "invalid_request" },
                  { "type": "string", "const": "unknown_view" },
                  { "type": "string", "const": "stale_view" },
                  { "type": "string", "const": "stale_zone" },
                  { "type": "string", "const": "too_large" },
                  { "type": "string", "const": "too_many" },
                  { "type": "string", "const": "busy" }
                ]
              },
              "msg": { "type": "string", "maxLength": 200 }
            }
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Tintero device API",
    "version": "1.0.0",
    "description": "Protocol v1 between e-ink devices and the Tintero server. Receivers ignore unknown fields. Without a valid device certificate every route answers 404 with no body."
  },
  "servers": [{ "url": "https://tintero.example" }],
  "security": [{ "deviceCertificate": [] }],
  "paths": {
    "/api/v1/index": {
      "get": {
        "operationId": "getIndex",
        "summary": "Index of views for the declared panel",
        "parameters": [
          {
            "name": "Tintero-Protocol",
            "in": "header",
            "required": true,
            "description": "Protocol version.",
            "schema": { "type": "string", "enum": ["1"] },
            "example": "1"
          },
          {
            "name": "Tintero-Firmware",
            "in": "header",
            "required": true,
            "description": "Firmware version text.",
            "schema": { "type": "string", "minLength": 1, "maxLength": 32 },
            "example": "0.1.0"
          },
          {
            "name": "Tintero-Power",
            "in": "header",
            "required": true,
            "description": "Power source.",
            "schema": { "type": "string", "enum": ["battery", "usb"] },
            "example": "battery"
          },
          {
            "name": "Tintero-Battery-mV",
            "in": "header",
            "required": false,
            "description": "Battery voltage in millivolts.",
            "schema": { "type": "integer", "minimum": 2500, "maximum": 4500 }
          },
          {
            "name": "Tintero-RSSI",
            "in": "header",
            "required": false,
            "description": "Wi-Fi signal in dBm.",
            "schema": { "type": "integer", "minimum": -120, "maximum": 0 }
          },
          {
            "name": "Tintero-Formats",
            "in": "header",
            "required": true,
            "description": "Comma separated image formats the device accepts (raw1, png1).",
            "schema": { "type": "string", "pattern": "^(raw1|png1)(,(raw1|png1))*$" },
            "example": "raw1"
          },
          {
            "name": "Tintero-Panel",
            "in": "header",
            "required": true,
            "description": "Panel the device declares: w=<width>,h=<height>,dpi=<ppp>,depth=<bits>.",
            "schema": {
              "type": "string",
              "pattern": "^w=\\d{1,4},h=\\d{1,4},dpi=\\d{1,3},depth=\\d$"
            },
            "example": "w=800,h=480,dpi=124,depth=1"
          }
        ],
        "responses": {
          "200": {
            "description": "Index",
            "headers": { "Tintero-Protocol": { "schema": { "type": "string", "enum": ["1"] } } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IndexResponse" },
                "example": {
                  "protocol": 1,
                  "server_time": 1761096000,
                  "next_wake_s": 1800,
                  "full_refresh": false,
                  "panel": { "w": 800, "h": 480, "dpi": 124, "depth": 1 },
                  "current": "todo",
                  "views": [
                    {
                      "id": "todo",
                      "hash": "9f2c1a7b",
                      "format": "raw1",
                      "bytes": 48000,
                      "crc32": "3a1f09c4"
                    },
                    {
                      "id": "agenda",
                      "hash": "41d0e2aa",
                      "format": "raw1",
                      "bytes": 48000,
                      "crc32": "b7e2d150"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid_request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "invalid_request", "msg": "invalid_request" } }
              }
            }
          },
          "404": {
            "description": "Unknown route, or the device has no valid certificate (empty body)."
          },
          "413": {
            "description": "too_large",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "too_large", "msg": "too_large" } }
              }
            }
          },
          "429": {
            "description": "too_many",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "too_many", "msg": "too_many" } }
              }
            }
          },
          "503": {
            "description": "busy",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "busy", "msg": "busy" } }
              }
            }
          }
        }
      }
    },
    "/api/v1/views/{id}/image": {
      "get": {
        "operationId": "getViewImage",
        "summary": "Image of a view (raw1 or png1)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
            "example": "todo"
          },
          {
            "name": "h",
            "in": "query",
            "required": true,
            "description": "Current hash of the view.",
            "schema": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" },
            "example": "9f2c1a7b"
          },
          {
            "name": "Tintero-Protocol",
            "in": "header",
            "required": true,
            "description": "Protocol version.",
            "schema": { "type": "string", "enum": ["1"] },
            "example": "1"
          },
          {
            "name": "Tintero-Firmware",
            "in": "header",
            "required": true,
            "description": "Firmware version text.",
            "schema": { "type": "string", "minLength": 1, "maxLength": 32 },
            "example": "0.1.0"
          },
          {
            "name": "Tintero-Power",
            "in": "header",
            "required": true,
            "description": "Power source.",
            "schema": { "type": "string", "enum": ["battery", "usb"] },
            "example": "battery"
          },
          {
            "name": "Tintero-Battery-mV",
            "in": "header",
            "required": false,
            "description": "Battery voltage in millivolts.",
            "schema": { "type": "integer", "minimum": 2500, "maximum": 4500 }
          },
          {
            "name": "Tintero-RSSI",
            "in": "header",
            "required": false,
            "description": "Wi-Fi signal in dBm.",
            "schema": { "type": "integer", "minimum": -120, "maximum": 0 }
          },
          {
            "name": "Tintero-Formats",
            "in": "header",
            "required": true,
            "description": "Comma separated image formats the device accepts (raw1, png1).",
            "schema": { "type": "string", "pattern": "^(raw1|png1)(,(raw1|png1))*$" },
            "example": "raw1"
          },
          {
            "name": "Tintero-Panel",
            "in": "header",
            "required": true,
            "description": "Panel the device declares: w=<width>,h=<height>,dpi=<ppp>,depth=<bits>.",
            "schema": {
              "type": "string",
              "pattern": "^w=\\d{1,4},h=\\d{1,4},dpi=\\d{1,3},depth=\\d$"
            },
            "example": "w=800,h=480,dpi=124,depth=1"
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes; raw1 is ceil(w/8)*h bytes, 1 = black, MSB first.",
            "headers": { "ETag": { "schema": { "type": "string" }, "example": "\"9f2c1a7b\"" } },
            "content": {
              "image/png": { "schema": { "type": "string", "format": "binary" } },
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "304": { "description": "Same hash as If-None-Match." },
          "400": {
            "description": "invalid_request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "invalid_request", "msg": "invalid_request" } }
              }
            }
          },
          "404": {
            "description": "unknown_view",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "unknown_view", "msg": "unknown_view" } }
              }
            }
          },
          "409": {
            "description": "stale_view",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "stale_view", "msg": "stale_view" } }
              }
            }
          },
          "413": {
            "description": "too_large",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "too_large", "msg": "too_large" } }
              }
            }
          },
          "429": {
            "description": "too_many",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "too_many", "msg": "too_many" } }
              }
            }
          },
          "503": {
            "description": "busy",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" },
                "example": { "error": { "code": "busy", "msg": "busy" } }
              }
            }
          }
        }
      }
    },

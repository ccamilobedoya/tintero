{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tintero.example/contract/v1/zones.schema.json",
  "type": "object",
  "required": ["view", "hash", "zones"],
  "properties": {
    "view": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "w", "h", "act"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
          "x": { "type": "integer", "minimum": 0, "maximum": 2048 },
          "y": { "type": "integer", "minimum": 0, "maximum": 2048 },
          "w": { "type": "integer", "minimum": 8, "maximum": 2048 },
          "h": { "type": "integer", "minimum": 8, "maximum": 2048 },
          "act": {
            "anyOf": [
              { "type": "string", "const": "toggle" },
              { "type": "string", "const": "open" }
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 48
    }
  }
}

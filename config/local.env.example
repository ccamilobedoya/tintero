# Copiar a ~/.config/tintero/local.env (fuera del repo, permisos 600) y llenar con valores reales.
# Nunca poner valores reales en el repo (ADR-0023).
TRILIUM_ETAPI_URL=http://127.0.0.1:<puerto>/etapi
TRILIUM_TOKEN_FILE=~/.config/<carpeta>/env
TRILIUM_FICHAS_NOTE_ID=<id-de-la-nota-Fichas>
# Servicio (F-010, tools/instalar-servicio): una línea cada una, sin saltos, «@», «%» ni «$».
TINTERO_DIR=/ruta/absoluta/al/repo
TINTERO_NODE=/ruta/absoluta/a/node
TINTERO_ARGS=--instance servicio --views <archivo> --data <archivo>
# Nodo de Tailscale propio (F-012, tools/instalar-funnel).
TINTERO_FUNNEL_DIR=/ruta/absoluta/a/la/carpeta/del/nodo
TINTERO_TLS_PORT=<puerto TLS local de Tintero, 1024-65535>
TINTERO_AUTHKEY_FILE=/ruta/absoluta/al/archivo/con/TS_AUTHKEY
# Opcionales de tools/prueba-recuperacion (F-011).
TINTERO_EMULATOR_ARGS=--ca <ca.crt> --cert <pN.crt> --key <pN.key>
TINTERO_TRILIUM_CONTAINER=<nombre del contenedor de Trilium>

{
  "version": 1,
  "timezone": "America/Lima",
  "locale": "en",
  "holidays": { "country": "CO" },
  "theme": "base",
  "devices": {
    "*": { "views": ["hoy", "tablero"] }
  },
  "views": [
    {
      "id": "hoy",
      "title": "Today",
      "grid": {
        "columns": [62, 38],
        "rows": [45, 55],
        "areas": [
          ["tareas", "proximos"],
          ["tareas", "mes"]
        ]
      },
      "portrait": {
        "columns": [100],
        "rows": [55, 20, 25],
        "areas": [["tareas"], ["proximos"], ["mes"]]
      },
      "slots": {
        "tareas": {
          "block": "task-board",
          "source": "tablero",
          "options": { "stages": ["doing", "todo"], "lead": true }
        },
        "proximos": {
          "block": "agenda",
          "source": "calendario",
          "title": "Upcoming events",
          "options": { "days": 7, "layout": "column" }
        },
        "mes": { "block": "month-calendar", "source": "calendario" }
      }
    },
    {
      "id": "tablero",
      "title": "Board",
      "grid": {
        "columns": [32, 38, 30],
        "rows": [100],
        "areas": [["por_hacer", "en_progreso", "hechas"]]
      },
      "portrait": {
        "columns": [100],
        "rows": [30, 50, 20],
        "areas": [["en_progreso"], ["por_hacer"], ["hechas"]]
      },
      "tab": ["en_progreso", "por_hacer", "hechas"],
      "slots": {
        "por_hacer": {
          "block": "task-board",
          "source": "tablero",
          "options": { "stages": ["todo"], "density": "card", "group_by": "none" }
        },
        "en_progreso": {
          "block": "task-board",
          "source": "tablero",
          "options": { "stages": ["doing"], "lead": true }
        },
        "hechas": {
          "block": "task-board",
          "source": "tablero",
          "options": { "stages": ["done"], "density": "card" }
        }
      }
    }
  ]
}

{
  "version": 1,
  "timezone": "America/Lima",
  "locale": "en",
  "theme": "base",
  "holidays": { "country": "CO" },
  "devices": {
    "*": { "views": ["agenda"] }
  },
  "views": [
    {
      "id": "agenda",
      "title": "Agenda",
      "grid": {
        "columns": [62, 38],
        "rows": [100],
        "areas": [["eventos", "mes"]]
      },
      "slots": {
        "eventos": {
          "block": "agenda",
          "source": "calendario",
          "title": "Upcoming events",
          "options": { "days": 7, "holidays": true }
        },
        "mes": { "block": "month-calendar", "source": "calendario" }
      }
    }
  ]
}

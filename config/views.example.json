{
  "version": 1,
  "timezone": "UTC",
  "theme": "base",
  "devices": {
    "*": { "views": ["hoy", "pendientes", "agenda"] }
  },
  "views": [
    {
      "id": "hoy",
      "title": "Hoy",
      "grid": {
        "columns": [50, 50],
        "rows": [55, 45],
        "areas": [
          ["pendientes", "eventos"],
          ["jira", "calendario"]
        ]
      },
      "portrait": {
        "columns": [100],
        "rows": [35, 25, 15, 25],
        "areas": [["pendientes"], ["eventos"], ["jira"], ["calendario"]]
      },
      "slots": {
        "pendientes": { "block": "task-list", "source": "tareas", "title": "Pendientes" },
        "eventos": { "block": "agenda", "source": "calendario", "title": "Próximos eventos" },
        "jira": { "block": "issue-list", "source": "jira", "title": "Jira" },
        "calendario": { "block": "month-calendar", "source": "calendario" }
      }
    },
    {
      "id": "pendientes",
      "title": "Pendientes",
      "grid": { "columns": [100], "rows": [100], "areas": [["lista"]] },
      "slots": {
        "lista": { "block": "task-list", "source": "tareas", "options": { "group_by": "category" } }
      }
    },
    {
      "id": "agenda",
      "title": "Agenda",
      "grid": { "columns": [100], "rows": [100], "areas": [["eventos"]] },
      "slots": {
        "eventos": { "block": "agenda", "source": "calendario", "options": { "days": 7 } }
      }
    }
  ]
}
